<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Boston Control Center Agent</title>
  <organization>com.bostonglobe</organization>

  <welcome    file="welcome.html"    mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>

  <!-- customize="never" because there is exactly one component and a choice
       list with one box in it only invites someone to uncheck it. -->
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>

  <!-- 14.4 is not a preference. Core Audio process taps, which is how the BPD
       feed gets captured out of a browser tab, did not exist before it. -->
  <volume-check>
    <allowed-os-versions>
      <os-version min="14.4"/>
    </allowed-os-versions>
  </volume-check>

  <!-- System volume only. The payload has to live at a fixed absolute path
       because bcc-agent.js already looks for its helpers there. -->
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>

  <choices-outline>
    <line choice="default"/>
  </choices-outline>

  <choice id="default" title="Boston Control Center Agent">
    <pkg-ref id="com.bostonglobe.bcc"/>
  </choice>

  <pkg-ref id="com.bostonglobe.bcc" version="1.0" onConclusion="none">bcc-payload.pkg</pkg-ref>
</installer-gui-script>
